# Copy to .env.local for development overrides.
#
# Leave EXPO_PUBLIC_API_URL unset in development: the app then derives the API host from the
# machine Metro is running on, which is what a phone on the same Wi-Fi needs.
#
# Set it when the API is not on your dev machine, and ALWAYS set it for EAS builds
# (see the env blocks in eas.json) — a release bundle has no Metro host to infer from.
# EXPO_PUBLIC_API_URL=http://192.168.1.100:4000

# Port used by the development fallback only. Defaults to 4000.
# EXPO_PUBLIC_API_PORT=4000
